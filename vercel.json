{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.2",
      "includeFiles": "{config/**,partials/**,*.php,api/_*.php}"
    }
  },
  "routes": [
    { "src": "/(config|vendor|database|tests|scripts|partials)(/.*)?", "status": 403 },
    { "src": "/api/_[^/]+(\\.[^/]+)?$", "status": 403 },
    { "src": "/api/pages(/.*)?$", "status": 403 },
    { "src": "/\\.env(\\.example)?$", "status": 403 },
    { "src": "/(composer\\.(json|lock)|\\.gitignore|README\\.md)$", "status": 403 },
    { "src": "^/[^/]+\\.php$", "status": 403 },
    { "src": "^/index/?$", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "^/([a-zA-Z0-9_-]+)/?$", "dest": "/api/pages/$1.php" }
  ]
}
